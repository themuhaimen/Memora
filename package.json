{
  "name": "memora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k \"npm:server:dev\" \"vite\"",
    "server": "node --env-file-if-exists=.env server/index.js",
    "server:dev": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "lint": "oxlint src",
    "test": "vitest",
    "push:keys": "node server/generate-vapid-keys.js --write",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.2",
    "@fontsource/dm-sans": "^5.3.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
